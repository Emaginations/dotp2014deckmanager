# ---------------------------------------------------------------- 索引与缓存
# `data/` 是**几万个文件、200MB+ 的本地缓存**，全部能由 tools/rebuild.py 重建，
# 而且里面混着 WAD 备份和缩略图 —— 都不该进版本库。
data/

# 打包产物（用户自己 build 出来的 WAD）
out/

# 用户自己的卡组工程 —— 是个人数据，不是源码
projects/

# ---------------------------------------------------------------- 构建产物
build/
dist/
*.spec.bak

# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------- 杂项
run.log
*.log
.DS_Store
Thumbs.db
*.swp

# PyInstaller 的临时目录（名字里带随机后缀，用通配兜住）
_MEI*/
